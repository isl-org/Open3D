Subject: [PATCH] backend/vulkan: implement importTextureR for external VkImage import

Implement VulkanDriver::importTextureR and fix VulkanTexture constructor to
support importing externally allocated VkImage handles (such as 3D Gaussian
Splatting compute targets) into Filament as zero-copy textures. Non-depth
textures are assumed to be in READ_WRITE (GENERAL) layout, while depth textures
are left UNDEFINED for Filament to manage transitions.

diff --git a/filament/backend/src/vulkan/VulkanDriver.cpp b/filament/backend/src/vulkan/VulkanDriver.cpp
index bf5604a0d..aa20c0020 100644
--- a/filament/backend/src/vulkan/VulkanDriver.cpp
+++ b/filament/backend/src/vulkan/VulkanDriver.cpp
@@ -549,7 +549,15 @@ void VulkanDriver::importTextureR(Handle<HwTexture> th, intptr_t id,
         SamplerType target, uint8_t levels,
         TextureFormat format, uint8_t samples, uint32_t w, uint32_t h, uint32_t depth,
         TextureUsage usage) {
-    // not supported in this backend
+    auto vktexture = mResourceAllocator.construct<VulkanTexture>(th, mPlatform->getDevice(),
+            mAllocator, &mCommands, (VkImage)id, getVkFormat(format),
+            samples, w, h, usage, mStagePool);
+    // Non-depth imports are populated externally in GENERAL layout. Depth
+    // imports remain UNDEFINED so Filament performs their initial transition.
+    if (!any(usage & TextureUsage::DEPTH_ATTACHMENT)) {
+        vktexture->setLayout(vktexture->getFullViewRange(), VulkanLayout::READ_WRITE);
+    }
+    mResourceManager.acquire(vktexture);
 }
 
 void VulkanDriver::destroyTexture(Handle<HwTexture> th) {
